# =======================================================
# PUNE RENT AGREEMENT AUTOMATION - ENVIRONMENT VARIABLES
# Copy this file to .env.local and populate the secrets.
# =======================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Service Role (SECRET - Server-side only, NEVER expose to browser)
# Used to bypass RLS for server API routes and write to private storage bucket "agreement-docs"
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Configuration (SECRET - Server-side only)
# Used for Aadhaar, PAN, and Electricity Bill structured document extraction
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Google Sheets Apps Script Webhook URL
# Target web app URL deployed from google-sheets-script.js
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Staff Authentication & Security
# Comma-separated list of allow-listed staff email addresses permitted to access staff panel
ALLOWED_STAFF_EMAILS=admin@agency.com,staff@agency.com

# Shared Staff Secret for Chrome Extension & Internal API requests
STAFF_API_SECRET=your-secure-random-staff-api-token
